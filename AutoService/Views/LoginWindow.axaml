<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="220"
        x:Class="AutoService.Views.LoginWindow"
        Title="Login">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto" Margin="10">
        <TextBlock Text="Имя пользователя:" Grid.Row="0" />
        <TextBox Name="UsernameText" Grid.Row="1" />
        <TextBlock Text="Пароль:" Grid.Row="2" />
        <TextBox Name="PasswordText" Grid.Row="3" PasswordChar="*" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Войти" Click="Login_Click" Margin="0,0,8,0" />
            <Button Content="Регистрация" Click="Register_Click" />
        </StackPanel>
    </Grid>
</Window>