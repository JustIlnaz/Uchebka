<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="300"
        x:Class="AutoService.Views.ServiceEditWindow"
        Title="Услуга">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *" Margin="10">
        <TextBlock Text="Название" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="NameText" Grid.Row="0" Grid.Column="1" Margin="8,0,0,4" />

        <TextBlock Text="Описание" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="DescriptionText" Grid.Row="1" Grid.Column="1" Margin="8,0,0,4" />

        <TextBlock Text="Базовая стоимость" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="PriceText" Grid.Row="2" Grid.Column="1" Margin="8,0,0,4" />

        <TextBlock Text="Длительность (мин)" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="DurationText" Grid.Row="3" Grid.Column="1" Margin="8,0,0,4" />

        <Button Content="Сохранить" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Save_Click" />
    </Grid>
</Window>