<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        x:Class="AutoService.Views.ClientEditWindow"
        Title="Клиент">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto" Margin="10">
        <TextBlock Text="ФИО:" Grid.Row="0"/>
        <TextBox Name="FullNameText" Grid.Row="0" Margin="80,0,0,0" />

        <TextBlock Text="Телефон:" Grid.Row="1"/>
        <TextBox Name="PhoneText" Grid.Row="1" Margin="80,0,0,0" />

        <TextBlock Text="Email:" Grid.Row="2"/>
        <TextBox Name="EmailText" Grid.Row="2" Margin="80,0,0,0" />

        <Button Content="Сохранить" Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Save_Click" />
    </Grid>
</Window>