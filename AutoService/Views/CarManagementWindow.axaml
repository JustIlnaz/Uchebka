<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="using:AutoService.Data"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AutoService.Views.CarManagementWindow"
        Title="Управление автомобилями">

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" />
            <TextBox x:Name="SearchText" Width="200" KeyUp="SearchText_KeyUp" />
            <Button Content="Сорт. по пробегу" Click="SortByMileage_Click" />
        </StackPanel>

        <ListBox Name="CarsListBox" Grid.Row="1" DoubleTapped="ListBox_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="data:Car">
                    <Border Padding="6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Make.Name}" Width="180" />
                            <TextBlock Text="{Binding Model}" Width="180" />
                            <TextBlock Text="{Binding RegistrationNumber}" Width="140" />
                            <TextBlock Text="{Binding Mileage}" Width="80" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
            <Button Content="← Назад" Click="PrevPage_Click" />
            <TextBlock x:Name="PageInfoText" VerticalAlignment="Center" />
            <Button Content="Вперёд →" Click="NextPage_Click" />
            <ComboBox x:Name="PageSizeCombo" Width="80" SelectionChanged="PageSize_Changed">
                <ComboBoxItem>10</ComboBoxItem>
                <ComboBoxItem>20</ComboBoxItem>
                <ComboBoxItem>50</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Добавить автомобиль" Click="AddButton_Click" Margin="0,0,8,0" />
        </StackPanel>
    </Grid>
</Window>