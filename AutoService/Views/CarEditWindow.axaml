<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
        x:Class="AutoService.Views.CarEditWindow"
        Title="Автомобиль">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *" Margin="10">
        <TextBlock Text="Клиент" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="ClientCombo" Grid.Row="0" Grid.Column="1" Margin="8,0,0,4" />

        <TextBlock Text="Марка" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="MakeCombo" Grid.Row="1" Grid.Column="1" Margin="8,0,0,4" />

        <TextBlock Text="Модель" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="ModelText" Grid.Row="2" Grid.Column="1" Margin="8,0,0,4" />

        <TextBlock Text="Гос. номер" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="RegText" Grid.Row="3" Grid.Column="1" Margin="8,0,0,4" />

        <TextBlock Text="Пробег" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="MileageText" Grid.Row="4" Grid.Column="1" Margin="8,0,0,4" />

        <Button Content="Сохранить" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Save_Click" />
    </Grid>
</Window>