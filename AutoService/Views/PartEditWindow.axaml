<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="350"
        x:Class="AutoService.Views.PartEditWindow"
        Title="Запчасть">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" Margin="10">
        <TextBlock Text="Поставщик" Grid.Row="0"/>
        <ComboBox Name="SupplierCombo" Grid.Row="0" Margin="120,0,0,0" />

        <TextBlock Text="Артикул" Grid.Row="1"/>
        <TextBox Name="SkuText" Grid.Row="1" Margin="120,0,0,0" />

        <TextBlock Text="Цена продажи" Grid.Row="2"/>
        <TextBox Name="SalePriceText" Grid.Row="2" Margin="120,0,0,0" />

        <TextBlock Text="Количество на складе" Grid.Row="3"/>
        <TextBox Name="QuantityText" Grid.Row="3" Margin="120,0,0,0" />

        <Button Content="Сохранить" Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Save_Click" />
    </Grid>
</Window>