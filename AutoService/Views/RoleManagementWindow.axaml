<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="AutoService.Views.RoleManagementWindow"
        Title="Manage Roles">

    <Grid RowDefinitions="*, Auto" Margin="8">
        <ListBox x:Name="RolesListBox" Grid.Row="0" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="AddButton" Content="Add" Click="AddButton_Click" />
            <Button x:Name="EditButton" Content="Edit" Click="EditButton_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" />
        </StackPanel>
    </Grid>
</Window>