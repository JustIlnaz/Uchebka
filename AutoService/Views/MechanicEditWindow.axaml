<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="220"
        x:Class="AutoService.Views.MechanicEditWindow"
        Title="Механик">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *" Margin="10">
        <TextBlock Text="Пользователь" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="UserCombo" Grid.Row="0" Grid.Column="1" Margin="8,0,0,4"/>

        <TextBlock Text="Отдел" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="DepartmentCombo" Grid.Row="1" Grid.Column="1" Margin="8,0,0,4"/>

        <TextBlock Text="Специализация" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="SpecializationCombo" Grid.Row="2" Grid.Column="1" Margin="8,0,0,4"/>

        <Button Content="Сохранить" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Save_Click"/>
    </Grid>
</Window>